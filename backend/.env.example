# Server
PORT=3000
NODE_ENV=development

# Database
DB_HOST=postgres
DB_PORT=5432
DB_NAME=flight_notifier
DB_USER=postgres
DB_PASSWORD=postgres

# RabbitMQ
RABBITMQ_URL=amqp://rabbitmq:5672
FLIGHT_UPDATES_QUEUE=flight_updates
TRAFFIC_UPDATES_QUEUE=traffic_updates

# JWT
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Email Service (Gmail)
# To use Gmail:
# 1. Go to https://myaccount.google.com/security
# 2. Enable 2-Step Verification
# 3. Go to https://myaccount.google.com/apppasswords
# 4. Generate an app password for "Mail"
# 5. Use your Gmail address for SMTP_USER and the app password for SMTP_PASS
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password
EMAIL_FROM=Flight Notifier <your-email@gmail.com>
