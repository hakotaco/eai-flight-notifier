graph TB
    User((User))
    
    subgraph Frontend["Frontend - Next.js"]
        SignupForm[Signup Form]
    end
    
    subgraph Backend["Backend - Central Service"]
        API[REST API]
        SubMgmt[Subscription Management]
        QueueConsumer[RabbitMQ Consumer]
        FlightHandler[Flight Update Handler]
        TrafficHandler[Traffic Update Handler]
        EmailNotif[Email Notification Service]
    end
    
    subgraph Database["PostgreSQL Database"]
        UsersTable[(users)]
        FlightsTable[(flights)]
        SubsTable[(user_flight_subscription)]
        FlightStateTable[(flight_state)]
        MapsTable[(travel_times)]
    end
    
    subgraph RabbitMQ["RabbitMQ Message Broker<br/>vhost: flight_ops"]
        Exchange["flight.events<br/>(Topic Exchange)"]
        FlightQueue{{"flight.delayed<br/>(Queue)"}}
        SubQueue{{"new_subscriptions<br/>(Queue)"}}
        TrafficQueue{{"traffic.updates<br/>(Queue)"}}
        
        Exchange -.->|binding: flight.delayed| FlightQueue
        Exchange -.->|binding: subscription.*| SubQueue
        Exchange -.->|binding: traffic.alert| TrafficQueue
    end
    
    subgraph SchipholCron["Schiphol API Service<br/>(Cron: every 2 min)"]
        SchipholBlackbox["• Polls Schiphol API<br/>• Detects flight delays<br/>• Updates flight states"]
    end
    
    subgraph MapsCron["Maps API Service<br/>(Cron: TBD)"]
        MapsBlackbox["• Calculates travel time<br/>• Monitors traffic<br/>• Schedules notifications"]
    end
    
    SchipholAPI[Schiphol Public API]
    GoogleMaps[Google Maps API]
    EmailService[Email Service<br/>Gmail SMTP]
    
    %% User Flow
    User -->|1. Sign up & Subscribe| SignupForm
    SignupForm -->|2. POST /api/auth/signup| API
    
    %% Backend Signup Flow
    API -->|3. Create User| UsersTable
    API -->|4. Create Flight Record| FlightsTable
    API -->|5. Create Subscription| SubsTable
    API -->|6. Query Flight Details| FlightStateTable
    API -->|7. Publish new_subscription| Exchange
    API -->|8. Send Confirmation Email| EmailService
    
    %% Schiphol Service Flow
    SchipholAPI -->|Flight Data| SchipholBlackbox
    SchipholBlackbox -->|Store/Update| FlightStateTable
    SchipholBlackbox -->|Publish Delay Events| Exchange
    
    %% Backend Consumption Flow
    FlightQueue -->|9. Consume Messages| QueueConsumer
    QueueConsumer -->|10. Process| FlightHandler
    FlightHandler -->|11. Check Subscriptions| SubsTable
    FlightHandler -->|12. Update Flight| FlightsTable
    FlightHandler -->|13. Send Delay Notification| EmailNotif
    EmailNotif -->|14. Email| EmailService
    
    %% Maps Service Flow
    SubQueue -->|Subscribe Events| MapsBlackbox
    MapsBlackbox -->|Read Departure Times| FlightStateTable
    MapsBlackbox -->|Store Travel Data| MapsTable
    GoogleMaps -->|Traffic Data| MapsBlackbox
    MapsBlackbox -->|Publish Traffic Alert<br/>at departure minus travel minus 30min| Exchange
    
    %% Backend Traffic Consumption Flow
    TrafficQueue -->|16. Consume Traffic Messages| QueueConsumer
    QueueConsumer -->|17. Process| TrafficHandler
    TrafficHandler -->|18. Send Traffic Notification| EmailNotif
    EmailNotif -->|19. Email| EmailService
    
    %% Final delivery
    EmailService -->|20. Notification Emails| User
    
    %% Styling
    classDef userStyle fill:#43a047,stroke:#1b5e20,stroke-width:3px,color:#fff
    classDef frontendStyle fill:#2e7d32,stroke:#1b5e20,stroke-width:2px,color:#fff
    classDef backendStyle fill:#388e3c,stroke:#1b5e20,stroke-width:2px,color:#fff
    classDef dbStyle fill:#2e7d32,stroke:#1b5e20,stroke-width:2px,color:#fff
    classDef queueStyle fill:#1b5e20,stroke:#0d3d10,stroke-width:3px,color:#fff
    classDef cronStyle fill:#2e7d32,stroke:#1b5e20,stroke-width:2px,color:#fff
    classDef externalStyle fill:#43a047,stroke:#2e7d32,stroke-width:2px,color:#fff
    
    class User userStyle
    class SignupForm frontendStyle
    class API,SubMgmt,QueueConsumer,FlightHandler,TrafficHandler,EmailNotif backendStyle
    class UsersTable,FlightsTable,SubsTable,FlightStateTable,MapsTable dbStyle
    class Exchange,FlightQueue,SubQueue,TrafficQueue queueStyle
    class SchipholBlackbox,MapsBlackbox cronStyle
    class SchipholAPI,GoogleMaps,EmailService externalStyle
