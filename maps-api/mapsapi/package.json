  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts"
  },
  "dependencies": {
    "amqplib": "^0.10.4",
    "axios": "^1.6.7",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "node-cron": "^3.0.3",
    "pg": "^8.11.3",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/amqplib": "^0.10.7",
    "@types/node-cron": "^3.0.10",
    "@types/pg": "^8.10.2",
    "@types/node": "^20.11.30",
    "@types/uuid": "^9.0.7",
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
