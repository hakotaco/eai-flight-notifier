{
  "name": "mapsapi-service",
  "version": "1.0.0",
  "private": true,
  "description": "Traffic notifier service using Google Maps API, RabbitMQ; sources users from PostgreSQL or dashboard and does not send emails.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "nodemon --watch src --exec ts-node src/index.ts"
  },
  "dependencies": {
    "amqplib": "^0.10.4",
    "axios": "^1.6.7",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "node-cron": "^3.0.3",
    "pg": "^8.11.3",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/amqplib": "^0.10.7",
    "@types/node-cron": "^3.0.10",
    "@types/pg": "^8.10.2",
    "@types/node": "^20.11.30",
    "@types/uuid": "^9.0.7",
    "nodemon": "^3.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
