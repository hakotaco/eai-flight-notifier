
# =================================================================
# REQUIRED: API Keys & Credentials - Set these before running
# =================================================================

# Schiphol API (get from https://developer.schiphol.nl/)
SCHIPHOL_APP_ID=<your-schiphol-app-id>
SCHIPHOL_APP_KEY=<your-schiphol-app-key>

# Google Maps API (get from https://console.cloud.google.com/)
# Enable: Directions API, Geocoding API
GOOGLE_MAPS_API_KEY=<your-google-maps-api-key>

# Gmail App Password (get from https://myaccount.google.com/security)
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=<your-gmail-app-password>

# =================================================================
# Database Configuration
# =================================================================

DB_HOST=localhost
DB_PORT=5432
DB_USER=admin
DB_PASS=password
DB_NAME=flight_ingestion

# =================================================================
# RabbitMQ Configuration
# =================================================================

MQ_HOST=localhost
MQ_PORT=5672
MQ_MANAGEMENT_PORT=16572
MQ_USER=admin
MQ_PASS=password
MQ_ERLANG_COOKIE=REPLACE_WITH_A_LONG_RANDOM_STRING

# =================================================================
# Schiphol API Configuration
# =================================================================

SCHIPHOL_API_URL=https://api.schiphol.nl

# =================================================================
# Authentication & Security
# =================================================================

JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRES_IN=7d

# =================================================================
# Email Service Configuration
# =================================================================

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_FROM=Flight Notifier <noreply@flightnotifier.com>

# Backend URL (for unsubscribe links)
BACKEND_URL=http://localhost:3000

# =================================================================
# Queue Names
# =================================================================

FLIGHT_UPDATES_QUEUE=flight.delayed

# =================================================================
# Maps API Service Configuration
# =================================================================

# HTTP server port for this service (avoid clashing with backend:3000)
PORT=3002

# RabbitMQ connection
RABBITMQ_URL=amqp://admin:password@localhost:5672
RABBITMQ_EXCHANGE=traffic.notifications

# Queues used for integration with dashboard and Schiphol RPC
DASHBOARD_TRAVELERS_QUEUE=dashboard.travelers
SCHIPHOL_ARRIVAL_REQUEST_QUEUE=schiphol.arrival.request

# RPC timeout (ms) for Schiphol arrival info calls
RPC_TIMEOUT_MS=8000

# Only process travelers departing within the next N hours
POLL_WINDOW_HOURS=4

# Default destination airport name used for routing
SCHIPHOL_ADDRESS=Amsterdam Airport Schiphol

# Dashboard/Backend API URL for fetching all travelers
DASHBOARD_USERS_URL=http://localhost:3000/api/users/travelers

# Cron pattern for periodic traffic checks (default: every hour at minute 0)
POLL_CRON=0 * * * *
